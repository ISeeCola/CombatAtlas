{
  "name": "combat-atlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-vinext.mjs dev",
    "build": "node scripts/run-vinext.mjs build",
    "preview": "vite preview",
    "sources:sync": "node scripts/sources-workbook.mjs --sync",
    "sources:check": "node scripts/sources-workbook.mjs --check",
    "sources:verify-generated": "node scripts/sources-workbook.mjs --verify-generated",
    "docs:sync": "node scripts/sync-curation-docs.mjs",
    "docs:check": "node scripts/sync-curation-docs.mjs --check",
    "review:validate": "node scripts/review-workbook.mjs --validate",
    "workbooks:install-macros": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-workbook-macros.ps1",
    "lint": "oxlint app/page.tsx app/combat-atlas-client.tsx app/sources.ts app/layout.tsx components/ui/select.tsx lib/personal-state.ts scripts/*.mjs tests/*.mjs vite.config.ts next.config.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test --experimental-strip-types tests/*.test.mjs",
    "audit:high": "npm audit --audit-level=high",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@gsap/react": "^2.1.2",
    "clsx": "2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "node": "22.23.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "type": "module"
}
